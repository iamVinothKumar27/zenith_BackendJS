# Server
PORT=5000
APP_ENV=development

# MongoDB Atlas
MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="zenith"

# Firebase Admin (server-side token verification)
FIREBASE_SERVICE_ACCOUNT_PATH="/absolute/path/to/firebase-service-account.json"
# OR:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ... }'

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MINDMAP_MODEL=gemini-3.5-flash

# YouTube Data API
YOUTUBE_API_KEY=

# Supadata (transcripts)
SUPADATA_KEY=

# Password reuse-detection pepper
PASSWORD_PEPPER=change-me-to-a-long-random-string

# Frontend URL (used to build absolute links in emails)
FRONTEND_BASE_URL=http://localhost:5173
PUBLIC_BASE_URL=

# Admin access
ADMIN_EMAIL=admin@zenithlearning.site
ADMIN_EMAILS=
CONTACT_INBOX=contact@zenithlearning.site

# Email — SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT=8

MAIL_FROM_DEFAULT=
MAIL_FROM_AUTH=authentication@zenithlearning.site
MAIL_FROM_COURSES=courses@zenithlearning.site
MAIL_FROM_PROFILE=profile@zenithlearning.site
MAIL_FROM_ADMIN=admin@zenithlearning.site
MAIL_FROM_CONTACT=contact@zenithlearning.site
MAIL_FROM_MOCKTEST=zenith-tests@zenithlearning.site
MAIL_FROM_ATS=ats-intelligence@zenithlearning.site

# Email — SendGrid (optional alternative to SMTP)
SENDGRID_API_KEY=
SENDGRID_FROM=

# Email — Mailgun (optional alternative to SMTP)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_FROM=
USE_MAILGUN=
MAIL_PROVIDER=

# Affinda (resume parsing, used by ATS analyzer — read directly via process.env)
AFFINDA_API_KEY=
AFFINDA_WORKSPACE=
AFFINDA_DOCTYPE_RESUME=
AFFINDA_DOCTYPE_JOB=
AFFINDA_BASE_URL=https://api.affinda.com

# Code execution providers (Mock Test coding questions)
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=

PISTON_BASE_URL=
PISTON_AUTH=

SPHERE_ENGINE_ENDPOINT=
SPHERE_ENGINE_TOKEN=
